{
  "enabled": true,
  "debug": false,
  "patterns": {
    "keywords": [],
    "regex": [
      { "pattern": "sk-[A-Za-z0-9]{48}", "category": "OPENAI_KEY" },
      { "pattern": "sk-(proj|ant)-[A-Za-z0-9_-]{20,}", "category": "AI_PROVIDER_KEY" },
      { "pattern": "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}", "category": "GITHUB_TOKEN" },
      { "pattern": "github_pat_[A-Za-z0-9_]{70,}", "category": "GITHUB_FINE_GRAINED_TOKEN" },
      { "pattern": "glpat-[A-Za-z0-9_-]{20,}", "category": "GITLAB_TOKEN" },
      { "pattern": "AKIA[0-9A-Z]{16}", "category": "AWS_ACCESS_KEY" },
      { "pattern": "ASIA[0-9A-Z]{16}", "category": "AWS_TEMP_ACCESS_KEY" },
      { "pattern": "(?i)aws_secret_access_key\\s*[:=]\\s*['\"]?[A-Za-z0-9/+=]{40}['\"]?", "category": "AWS_SECRET_KEY" },
      { "pattern": "AIza[0-9A-Za-z_-]{35}", "category": "GOOGLE_API_KEY" },
      { "pattern": "ya29\\.[0-9A-Za-z_-]{20,}", "category": "GOOGLE_OAUTH_TOKEN" },
      { "pattern": "xox[baprs]-[0-9A-Za-z-]{10,}", "category": "SLACK_TOKEN" },
      { "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/]{20,}", "category": "SLACK_WEBHOOK" },
      { "pattern": "sk_(live|test)_[0-9A-Za-z]{16,}", "category": "STRIPE_SECRET_KEY" },
      { "pattern": "(pk|rk)_(live|test)_[0-9A-Za-z]{16,}", "category": "STRIPE_KEY" },
      { "pattern": "SG\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}", "category": "SENDGRID_KEY" },
      { "pattern": "SK[0-9a-fA-F]{32}", "category": "TWILIO_KEY" },
      { "pattern": "AC[0-9a-fA-F]{32}", "category": "TWILIO_SID" },
      { "pattern": "npm_[A-Za-z0-9]{36}", "category": "NPM_TOKEN" },
      { "pattern": "dop_v1_[a-f0-9]{64}", "category": "DIGITALOCEAN_TOKEN" },
      { "pattern": "[a-z0-9]{32}\\.[a-f0-9]{24}\\.(discord|MTI)[A-Za-z0-9_-]{20,}", "category": "DISCORD_TOKEN" },
      { "pattern": "key-[0-9a-zA-Z]{32}", "category": "MAILGUN_KEY" },
      { "pattern": "(?i)-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----[\\s\\S]+?-----END (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----", "category": "PRIVATE_KEY_BLOCK" },
      { "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "category": "JWT" },
      { "pattern": "(?i)(postgres(ql)?|mysql|mongodb(\\+srv)?|redis|amqp)://[^\\s:]+:[^\\s@]+@[^\\s/]+", "category": "DB_CONNECTION_STRING" },
      { "pattern": "(?i)(api[_-]?key|secret|token|passwd|password)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-/+=]{16,}['\"]", "category": "GENERIC_SECRET_ASSIGNMENT" },
      { "pattern": "(?i)bearer\\s+[A-Za-z0-9._-]{20,}", "category": "BEARER_TOKEN" },
      { "pattern": "(?i)DefaultEndpointsProtocol=https?;AccountName=[^;]+;AccountKey=[^;]+", "category": "AZURE_STORAGE_CONNECTION_STRING" },
      { "pattern": "[us]-s4t2ud-[a-f0-9]{64}", "category": "FORTY_TWO_KEY" },
      { "pattern": "(?<!\\d)(?:\\+33|0)\\d{9}(?!\\d)", "category": "FR_PHONE" }
    ],
    "builtin": ["ipv4", "mac"],
    "exclude": ["example.com", "localhost", "127.0.0.1"]
  }
}
