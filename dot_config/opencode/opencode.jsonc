{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3",
  "plugins": [
    // v1 of this plugin never loads on v2; this is PR #11 (dual v1+v2) from source
    "/home/maplepy/.config/opencode/plugins/vibeguard-v2",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail@4.10.3"
  ],
  "lsp": true,
  "formatter": true,
  // V2 allows everything by default; only the exceptions below need rules.
  // gh reads are silent; gh deletes and git push still ask.
  "permissions": [
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "agent-browser_*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "ask" },
    { "action": "shell", "resource": "cargo publish *", "effect": "ask" },
    { "action": "shell", "resource": "gh * delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh * merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh api -X DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "gh api --method DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "gh api --method=DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "su", "effect": "deny" }
  ],
  "agents": {
    "plan": {
      "color": "#fc9b6f",
      "permissions": [
        { "action": "edit", "resource": "CONTEXT.md", "effect": "allow" },
        { "action": "edit", "resource": "CONTEXT-MAP.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/adr/**", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "build": {
      "color": "#8da4f5"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "environment": {
          "CONTEXT7_API_KEY": ""
        }
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp", "--tools", "core,webmcp"],
        "environment": {
          "ANONYMIZED_TELEMETRY": "false"
        }
      }
    }
  }
}
