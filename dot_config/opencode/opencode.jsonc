{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail@4.10.3"
  ],
  "lsp": true,
  "formatter": true,
  "agent": {
    "plan": {
      "color": "#fc9b6f",
      "permission": {
        "edit": {
          "CONTEXT.md": "allow",
          "CONTEXT-MAP.md": "allow",
          "docs/adr/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "rm *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "su": "deny",
          "git push *": "ask",
          "git reset --hard *": "ask",
          "git clean *": "ask",
          "npm publish *": "ask",
          "cargo publish *": "ask",
          "gh *": "ask",
          "gh pr view*": "allow",
          "gh pr list*": "allow",
          "gh pr diff*": "allow",
          "gh pr status*": "allow",
          "gh pr checks*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow",
          "gh issue status*": "allow",
          "gh repo view*": "allow",
          "gh repo list*": "allow",
          "gh run list*": "allow",
          "gh run view*": "allow",
          "gh workflow list*": "allow",
          "gh workflow view*": "allow",
          "gh release list*": "allow",
          "gh release view*": "allow",
          "gh gist list*": "allow",
          "gh gist view*": "allow",
          "gh search *": "allow",
          "gh status*": "allow",
          "gh auth status*": "allow",
          "gh browse*": "allow",
          "gh label list*": "allow",
          "gh api *": "ask"
        }
      }
    },
    "build": {
      "color": "#8da4f5"
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "su": "deny",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "npm publish *": "ask",
      "cargo publish *": "ask",
      "gh *": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status*": "allow",
      "gh repo view*": "allow",
      "gh repo list*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh gist list*": "allow",
      "gh gist view*": "allow",
      "gh search *": "allow",
      "gh status*": "allow",
      "gh auth status*": "allow",
      "gh browse*": "allow",
      "gh label list*": "allow",
      "gh api *": "ask"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "browser-use": {
      "type": "local",
      "command": ["browser-use", "--mcp"],
      "enabled": true,
      "environment": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}
