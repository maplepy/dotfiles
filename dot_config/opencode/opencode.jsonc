{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["rules/concise.md"],
  "plugin": [
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp@latest"
  ],
 "lsp": true,
  "formatter": true,
  "agent": {
    "plan": {
      "color": "#fc9b6f",
      "permission": {
        "edit": {
          "CONTEXT.md": "allow",
          "CONTEXT-MAP.md": "allow",
          "docs/adr/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "ask",
          "rm *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "su": "deny",
          "* --version": "allow",
          "* --help": "allow",
          "jq *": "allow",

           "ls": "allow",
           "ls *": "allow",
           "mktemp -t handoff-XXXXXX.md": "allow",
           "ls /tmp && mktemp -t handoff-XXXXXX.md": "allow",
           "pwd": "allow",
          "cd *": "allow",
          "echo *": "allow",
          "printf *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "tree": "allow",
          "tree *": "allow",
          "diff *": "allow",
          "which *": "allow",
          "type *": "allow",
          "env": "allow",
          "env *": "allow",
          "date": "allow",
          "uname *": "allow",
          "whoami": "allow",
          "hostname": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "basename *": "allow",
          "dirname *": "allow",
      "realpath *": "allow",
          "timeout *": "allow",

          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git branch": "allow",
          "git branch *": "allow",
          "git remote": "allow",
          "git remote *": "allow",
          "git stash list": "allow",

          "gh *": "ask",
          "gh pr view*": "allow",
          "gh pr list*": "allow",
          "gh pr diff*": "allow",
          "gh pr status*": "allow",
          "gh pr checks*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow",
          "gh issue status*": "allow",
          "gh repo view*": "allow",
          "gh repo list*": "allow",
          "gh run list*": "allow",
          "gh run view*": "allow",
          "gh workflow list*": "allow",
          "gh workflow view*": "allow",
          "gh release list*": "allow",
          "gh release view*": "allow",
          "gh gist list*": "allow",
          "gh gist view*": "allow",
          "gh search *": "allow",
          "gh status*": "allow",
          "gh auth status*": "allow",
          "gh browse*": "allow",
          "gh label list*": "allow",
          "gh api *": "ask",

          "dex *": "allow"
        }
      }
    },
    "build": {
      "color": "#8da4f5"
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "ask",
      "rm *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "su": "deny",
      "* --version": "allow",
      "* --help": "allow",
      "jq *": "allow",

      "ls": "allow",
      "ls *": "allow",
      "mktemp -t handoff-XXXXXX.md": "allow",
      "ls /tmp && mktemp -t handoff-XXXXXX.md": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "which *": "allow",
      "type *": "allow",
      "env": "allow",
      "env *": "allow",
      "date": "allow",
      "uname *": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git stash list": "allow",

      "gh *": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status*": "allow",
      "gh repo view*": "allow",
      "gh repo list*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh gist list*": "allow",
      "gh gist view*": "allow",
      "gh search *": "allow",
      "gh status*": "allow",
      "gh auth status*": "allow",
      "gh browse*": "allow",
      "gh label list*": "allow",
      "gh api *": "ask",

      "dex *": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "browser-use": {
      "type": "local",
      "command": ["browser-use", "--mcp"],
      "enabled": true,
      "environment": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}
