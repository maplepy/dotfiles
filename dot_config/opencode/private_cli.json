{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark",
    "mode": "system"
  },
  "scroll": {
    "speed": 3
  },
  "diffs": {
    "wrap": "word",
    "view": "split",
    "tree": true,
    "single": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "verbosity": "medium",
    "markdown": "rendered",
    "permissions": "autoaccept"
  },
  "animations": true,
  "plugins": [
    "./herdr-opencode"
  ],
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "volume": 0.6,
    "sound": false,
    "notifications": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "debug": {
    "devtools": false
  }
}
